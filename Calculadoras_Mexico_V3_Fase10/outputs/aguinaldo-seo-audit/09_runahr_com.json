    "faqs_schema": [
      {
        "pregunta": "¿Qué es el aguinaldo y quién tiene derecho a recibirlo?",
        "respuesta": "<p><span style=\"font-weight: 400\">El </span><a href=\"https://runahr.com/mx/recursos/hr-management/aguinaldo/\"><span style=\"font-weight: 400\">aguinaldo</span></a><span style=\"font-weight: 400\"> es una de las </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/prestaciones-de-ley/\"><span style=\"font-weight: 400\">prestaciones de ley</span></a><span style=\"font-weight: 400\"> fija. Ya que está en la </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/ley-federal-del-trabajo-lft/\"><span style=\"font-weight: 400\">Ley Federal del Trabajo</span></a><span style=\"font-weight: 400\"> y no es negociable. ¿Quién lo recibe? Cualquier persona con </span><a href=\"https://runahr.com/mx/recursos/hr-management/relacion-laboral/\"><span style=\"font-weight: 400\">relación laboral</span></a><span style=\"font-weight: 400\"> activa. Puede ser </span><a href=\"https://runahr.com/mx/recursos/hr-management/trabajador/\"><span style=\"font-weight: 400\">trabajador</span></a><span style=\"font-weight: 400\"> de planta, medio tiempo o por contrato. Mientras esté en la </span><a href=\"https://runahr.com/mx/recursos/nomina/que-es-nomina/\"><span style=\"font-weight: 400\">nómina</span></a><span style=\"font-weight: 400\">, le toca.</span></p>"
      },
      {
        "pregunta": "¿Cuánto es el aguinaldo mínimo en México?",
        "respuesta": "<p><span style=\"font-weight: 400\">En México, el aguinaldo mínimo debe ser igual a 15 días de </span><a href=\"https://runahr.com/mx/recursos/nomina/salario/\"><span style=\"font-weight: 400\">salario</span></a><span style=\"font-weight: 400\">. Menos de eso, no se puede. Si la </span><a href=\"https://runahr.com/mx/recursos/comienza-tu-empresa/guia-para-crear-una-empresa/\"><span style=\"font-weight: 400\">empresa</span></a><span style=\"font-weight: 400\"> quiere dar más, adelante. Pero recortar esa base… No es una opción.</span></p>"
      },
      {
        "pregunta": "¿Cuándo se debe pagar el aguinaldo?",
        "respuesta": "<p><span style=\"font-weight: 400\">Hay una fecha clara: </span><a href=\"https://runahr.com/mx/recursos/nomina/aguinaldo-2025/\"><span style=\"font-weight: 400\">cuando se paga el aguinaldo</span></a><span style=\"font-weight: 400\"> debe ser el 20 de diciembre como límite. Así que antes de esa fecha debe estar pagado el aguinaldo. Si no se paga a tiempo, puede haber sanciones. Y no son nada suaves.</span></p>"
      },
      {
        "pregunta": "¿Cómo se calcula el aguinaldo?",
        "respuesta": "<p><span style=\"font-weight: 400\">El cálculo es directo. Salario diario por 15 días. Si alguien no trabajó el año completo, solo se le paga el </span><a href=\"https://runahr.com/mx/recursos/nomina/aguinaldo-proporcional/\"><span style=\"font-weight: 400\">aguinaldo proporcional</span></a><span style=\"font-weight: 400\">, según los días que estuvo activo.</span></p>"
      },
      {
        "pregunta": "¿El aguinaldo paga impuestos (ISR)?",
        "respuesta": "<p><span style=\"font-weight: 400\">Sí, pero no todo. El aguinaldo está exento de </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/calculadora-isr/\"><span style=\"font-weight: 400\">ISR</span></a><span style=\"font-weight: 400\"> hasta 30 </span><a href=\"https://runahr.com/mx/recursos/nomina/uma/\"><span style=\"font-weight: 400\">UMA</span></a><span style=\"font-weight: 400\">. Lo que pase de ahí, sí paga. Y se retiene como cualquier otro ingreso.</span></p>"
      },
      {
        "pregunta": "¿Tengo derecho a aguinaldo si renuncio o me despiden?",
        "respuesta": "<p><span style=\"font-weight: 400\">Sí. Ya sea </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/renuncia-voluntaria-lft/\"><span style=\"font-weight: 400\">renuncia voluntaria</span></a><span style=\"font-weight: 400\"> o </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/despido/\"><span style=\"font-weight: 400\">despido</span></a><span style=\"font-weight: 400\">, da igual. Si trabajó ese año, le toca su parte. El aguinaldo proporcional va dentro del </span><a href=\"https://runahr.com/mx/recursos/nomina/finiquito/\"><span style=\"font-weight: 400\">finiquito</span></a><span style=\"font-weight: 400\">. No es opcional.</span></p>"
      },
      {
        "pregunta": "¿Qué pasa si la empresa no paga el aguinaldo?",
        "respuesta": "<p><span style=\"font-weight: 400\">Pues no es menor. No pagar el aguinaldo rompe la ley. Y trae varios focos rojos:</span></p> <ul> <li style=\"font-weight: 400\"><span style=\"font-weight: 400\">Multas</span></li> <li style=\"font-weight: 400\"><span style=\"font-weight: 400\">Quejas en la </span><a href=\"https://runahr.com/mx/recursos/aspectos-legales/profedet/\"><span style=\"font-weight: 400\">PROFEDET</span></a></li> <li style=\"font-weight: 400\"><span style=\"font-weight: 400\">Y demandas, si se pone tensa la cosa</span></li> </ul> <p><span style=\"font-weight: 400\">No es algo que convenga dejar pasar.</span></p>"
      }
    ]
  },
